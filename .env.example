GO2_BACKEND=sport
GO2_PIN=change-me
GO2_WATCHDOG_MS=350
GO2_MAX_FORWARD=0.8
GO2_MAX_LATERAL=0.45
GO2_MAX_YAW=1.2
GO2_VIDEO_MODE=sdk
GO2_NET_IFACE=enp3s0
GO2_SPORT_STATE_TOPIC=lf/sportmodestate
GO2_LOW_STATE_TOPIC=lf/lowstate

# 树莓派 V1 策略后端（默认只影子推理，不创建 rt/lowcmd 发布器）
# GO2_BACKEND=policy
# GO2_NET_IFACE=eth0
# GO2_DDS_DOMAIN=0
# GO2_DDS_LOW_STATE_TOPIC=rt/lowstate
# GO2_DDS_LOW_CMD_TOPIC=rt/lowcmd
# GO2_POLICY_MODEL=policy_runtime/models/go2_blind_rough_v1.onnx
#
# 以下三项仅限机器狗可靠悬空、实体遥控器在手时临时设置：
# GO2_LOWLEVEL_ENABLE=1
# GO2_LOWLEVEL_TEST_MODE=suspended
# GO2_LOWLEVEL_CONFIRM=ROBOT_SUSPENDED_REMOTE_READY
# GO2_CMD_VEL_TOPIC=/cmd_vel
# GO2_JOY_TOPIC=/joy
# GO2_JOY_FORWARD_AXIS=1
# GO2_JOY_LATERAL_AXIS=0
# GO2_JOY_YAW_AXIS=3
# 如果 SBUS/Joy 驱动有“保持运控使能”按钮，请填实际索引；-1 表示不设置。
# GO2_JOY_BUTTON_COUNT=12
# GO2_JOY_ENABLE_BUTTON=-1
# GO2_JOY_ENABLE_VALUE=1
# GO2_VIDEO_MODE=url
# GO2_VIDEO_URL=http://192.168.1.20:8080/video
